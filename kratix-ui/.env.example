VITE_API_BASE_URL=http://localhost:5069/api
# Kratix Assistant (kratix-agent). Use 127.0.0.1: "localhost" tries IPv6 first on Windows and adds a delay.
VITE_AGENT_URL=http://127.0.0.1:5080
# true for the public demo (the API needs Demo__Enabled=true): one-click role sign-in instead of passwords.
VITE_DEMO_MODE=false
