# Copy to .env (git-ignored) and fill in AGENT_JWT_KEY and AGENT_GEMINI_API_KEY; other values override the defaults
# in app/config.py.
# The ERP's Jwt:Key. Required: the agent verifies sign-in tokens with it.
AGENT_JWT_KEY=
# Required: a Gemini API key from https://aistudio.google.com/apikey. It stays here, never in kratix-ui.
AGENT_GEMINI_API_KEY=
AGENT_GEMINI_MODEL=gemini-3.8-flash
AGENT_ERP_API_URL=http://127.0.0.1:5069/api
AGENT_COMPANY_NAME=Crescent Flour Mills
AGENT_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
